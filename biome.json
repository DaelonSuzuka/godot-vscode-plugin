{
    "$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
	"vcs": {
		"defaultBranch": "master"
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120,
		"lineEnding": "lf",
		"include": ["src/**/*.ts", "tools/**/*.ts"]
	},
	"files": {
		"include": ["src/**/*.ts", "tools/**/*.ts"],
		"ignore": ["node_modules", "src/dev/**"]
	},
	"linter": {
		"rules": {
			"style": {
				"noUselessElse": "off",
				"useImportType": "off",
                "noParameterAssign": "warn"
			},
            "suspicious": {
                "noExplicitAny": "off"
            }
		}
	},
	"overrides": [
		{
			"include": ["src/gdscript/**", "src/tscn/**"],
			"linter": {
				"rules": {
					"nursery": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"vscode": "src/gdscript is a vscode-free zone: core must run outside the extension host"
								}
							}
						}
					}
				}
			}
		}
	]
}
